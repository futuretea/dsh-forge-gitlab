{
  "name": "dsh-forge-gitlab",
  "version": "0.1.0",
  "description": "GitLab merge request provider for the DeepSeek Harness forge panel, read through the glab CLI",
  "type": "module",
  "license": "MIT",
  "author": "futuretea",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/futuretea/dsh-forge-gitlab.git"
  },
  "homepage": "https://github.com/futuretea/dsh-forge-gitlab#readme",
  "bugs": {
    "url": "https://github.com/futuretea/dsh-forge-gitlab/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "gitlab",
    "forge",
    "merge-request"
  ],
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "engines": {
    "dsh": ">=0.2.2-alpha.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "execa": "^10.0.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.1.0",
    "@deepseek-ai/dsh-experimental-forge": ">=0.2.2-alpha.2",
    "@deepseek-ai/dsh-subprocess": ">=0.2.2-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-experimental-forge": "0.2.2-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.2",
    "@types/node": "^24.0.0",
    "oxlint": "^1.93.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
